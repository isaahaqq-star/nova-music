{
  "name": "nova-music",
  "version": "1.0.0",
  "description": "NOVA MUSIC — ISA OS Music Infrastructure & 401K Player",
  "private": true,
  "workspaces": [
    "player",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm -w player run build",
