    "dev": "npm -w player run dev",
    "deploy:backend": "npm -w backend run deploy",
    "lint": "npm -w player run lint"
  },
  "keywords": [
    "music",
    "streaming",
    "cloudflare",
    "supabase",
    "401k",
    "yolajo"
  ],
